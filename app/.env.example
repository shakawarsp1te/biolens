# Copy to .env.local (Expo auto-loads EXPO_PUBLIC_* vars). Never commit the real file.
# Only NON-secret, publishable values belong here — this ships inside the app bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
# Where "Send beta feedback" on Profile opens an email to. The link is
# hidden until this is set. It ships in the app, so use an address meant to
# be public.
EXPO_PUBLIC_FEEDBACK_EMAIL=
