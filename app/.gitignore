# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
# Left gitignored (Expo's own default) rather than fighting it -- `expo
# start`/`expo install` re-add this line via their own "sync" mechanism
# every time they run locally, which silently undoes a manual un-ignore.
# CI safety for its absence lives in package.json's ensure-expo-env
# script instead (see prelint/pretypecheck).
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
