# Copy to .env. Never commit the real file — this holds secrets.
# Every setting here maps 1:1 to a field in app/core/config.py; see that
# file's comments for what each one actually does and what happens when
# it's left blank (most external integrations degrade gracefully rather
# than requiring a key to run at all).

ENVIRONMENT=development

# --- Supabase (Postgres + pgvector + Auth) — not provisioned yet; the
# interim local stores below (JWT_SECRET, *_DB_PATH) stand in until it is.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- LLM (app/services/llm.py) — required for Ask BioLens, interpretation,
# readout extraction, and the auto-discovery pipeline. Everything else in
# the app works without it.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Interim local account system (app/services/auth.py, user_store.py) ---
# Change this before any real deployment — the default is a known,
# publicly-visible value.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_MINUTES=10080
USER_DB_PATH=db/biolens_dev.sqlite3
COMPANY_DB_PATH=db/biolens_companies.sqlite3
# The API's own public URL — where email-verification links point.
API_PUBLIC_BASE_URL=http://localhost:8000

# --- Email delivery (app/services/email.py) — leave blank to use
# ConsoleEmailProvider, which logs the verification link instead of
# sending a real email (fine for local dev and a controlled beta).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=BioLens <no-reply@biolens.app>

# --- PubMed E-utilities — public API, no key required. Setting a contact
# email is NCBI's usage policy (identifies the caller); PUBMED_API_KEY is
# optional and only raises the rate limit from 3 req/sec to 10 req/sec.
PUBMED_CONTACT_EMAIL=
PUBMED_API_KEY=

# --- SEC EDGAR — public API, no key required. Same identification
# courtesy as PubMed's contact email above.
SEC_EDGAR_CONTACT_EMAIL=

# --- Admin gate for POST /companies/discover (real LLM + CT.gov cost per
# call). Leave blank for local dev; set this to any secret string before a
# public deploy, and pass the same value as the X-Admin-Token header.
ADMIN_TOKEN=
