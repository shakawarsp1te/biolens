# Copy to .env. Never commit the real file — this holds secrets.
ENVIRONMENT=development

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# PubMed E-utilities — public API, no key required. Setting a contact email
# is NCBI's usage policy (identifies the caller); PUBMED_API_KEY is optional
# and only raises the rate limit from 3 req/sec to 10 req/sec.
PUBMED_CONTACT_EMAIL=
PUBMED_API_KEY=
